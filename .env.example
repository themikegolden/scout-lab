# Owner authentication for the browser dashboard (Cloudflare Access)
OWNER_EMAIL=

# Local development only. Never set to 1 in production.
DEV_BYPASS_AUTH=0

# Stable browser URL shown by ChatGPT's Open in app control.
SCOUT_PUBLIC_URL=https://scoutlab.example.com

# Protected publisher endpoint for external/scheduled task publishers.
SCOUT_PUBLISH_TOKEN=

# ChatGPT Workspace Agent API trigger used by REFRESH EMAIL.
CHATGPT_AGENT_TRIGGER_ID=
CHATGPT_WORKSPACE_AGENT_TOKEN=

# Public MCP endpoint, normally SCOUT_PUBLIC_URL + /mcp.
SCOUT_MCP_URL=https://scoutlab.example.com/mcp

# Optional future direct Shopify Admin integration.
SHOPIFY_SHOP=
SHOPIFY_ADMIN_TOKEN=