# Scout Lab local overrides. Copy to .env.local (never commit .env.local).
# Local defaults: http://localhost:3100 and data/scout-lab.sqlite

# PORT=3100
# HOST=127.0.0.1
# SCOUT_DB_PATH=./data/scout-lab.sqlite

# Mailroom default: ChatGPT Workspace Agent + connected Gmail + Secure MCP Tunnel.
SCOUT_MAILROOM_MODE=workspace_agent
# CHATGPT_AGENT_TRIGGER_ID=agtch_...
# CHATGPT_WORKSPACE_AGENT_TOKEN=...
# SCOUT_TUNNEL_PROFILE=scout-lab
# CONTROL_PLANE_API_KEY=sk-...

# Only needed if you intentionally expose the Node server beyond localhost.
# SCOUT_BASIC_USER=scout
# SCOUT_BASIC_PASSWORD=choose-a-strong-password

# Optional fallback only. Scout Lab will NOT use IMAP unless SCOUT_MAILROOM_MODE=local_imap.
# GMAIL_USER=you@example.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
