# Scout Lab private local settings. Copy to .env.local; never commit .env.local.

# Local defaults:
# PORT=3100
# HOST=127.0.0.1
# SCOUT_DB_PATH=./data/scout-lab.sqlite

# Simple Mailroom mode:
# ChatGPT scheduled task -> connected Gmail -> summary snapshot email -> local Scout Lab
SCOUT_MAILROOM_MODE=chatgpt_task_relay
# GMAIL_USER=you@example.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# No Workspace Agent, OpenAI API key, or Secure MCP Tunnel is required for this mode.

# Optional owner auth if exposing the browser outside localhost.
# SCOUT_BASIC_USER=scout
# SCOUT_BASIC_PASSWORD=choose-a-strong-password
