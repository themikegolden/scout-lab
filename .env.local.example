# Scout Lab private local settings. Copy to .env.local; never commit .env.local.

# Local defaults:
# PORT=3100
# HOST=127.0.0.1
# SCOUT_DB_PATH=./data/scout-lab.sqlite

# Direct Mailroom flow:
# dashboard -> ChatGPT Workspace Agent -> connected Gmail -> Scout Lab MCP -> local SQLite
SCOUT_MAILROOM_MODE=workspace_agent_direct_publish
# CHATGPT_AGENT_TRIGGER_ID=agtch_...
# CHATGPT_WORKSPACE_AGENT_TOKEN=...
# SCOUT_TUNNEL_PROFILE=scout-lab
# SCOUT_TUNNEL_ID=tunnel_...
# CONTROL_PLANE_API_KEY=sk-...

# Optional owner auth if exposing the browser outside localhost.
# SCOUT_BASIC_USER=scout
# SCOUT_BASIC_PASSWORD=choose-a-strong-password
