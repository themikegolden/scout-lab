# Scout Lab private local settings. Copy to .env.local; never commit .env.local.

# Local defaults:
# PORT=3100
# HOST=127.0.0.1
# SCOUT_DB_PATH=./data/scout-lab.sqlite

# No-agent Mailroom:
# local read-only Gmail -> OpenAI Responses API -> local SQLite -> dashboard
SCOUT_MAILROOM_MODE=openai_api
# OPENAI_API_KEY=sk-...
OPENAI_MAIL_MODEL=gpt-5-mini
# GMAIL_USER=you@example.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional owner auth if exposing the browser outside localhost.
# SCOUT_BASIC_USER=scout
# SCOUT_BASIC_PASSWORD=choose-a-strong-password
