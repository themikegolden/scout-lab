{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "scout-lab-tough-stuff-gear",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scout-lab",
      "database_id": "REPLACE_WITH_EXISTING_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}